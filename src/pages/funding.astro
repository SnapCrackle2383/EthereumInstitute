<!-- Contribute modal -->
<div class="modal-overlay" id="contribute-modal" hidden aria-hidden="true" role="dialog" aria-labelledby="contribute-modal-title" aria-modal="true">
  <div class="modal-backdrop" onclick="closeContribute()"></div>
  <div class="modal-content" role="document">
    <div class="modal-header">
      <h2 class="modal-title" id="contribute-modal-title">Contribute</h2>
      <button type="button" class="btn-close" onclick="closeContribute()" aria-label="Close contribute dialog">Close</button>
    </div>
    <p class="modal-desc">Accepts ETH, stablecoins, or any other ERC-20 on Ethereum mainnet.</p>
    <div class="qr-frame">
      <div id="qr-code" aria-label="QR code for contribution address"></div>
    </div>
    <div class="qr-section-label">Contribution Address</div>
    <a href="https://etherscan.io/address/0x0000000000000000000000000000000000000000" target="_blank" rel="noopener" class="modal-address" id="modal-address-link">
      <span id="modal-addr-text">0x0000…0000</span>
      <svg class="ext-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3h7v7M13 3L6 10M11 8v5H3V5h5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
      </svg>
    </a>
    <button type="button" class="btn-copy-address" onclick="copyFromModal()">Copy Address</button>
  </div>
</div>
