<script is:inline>
/* ═══ Theme ═══ */
function toggleTheme(){
  const h=document.documentElement;
  const n=h.getAttribute('data-theme')==='dark'?'light':'dark';
  h.setAttribute('data-theme',n);
  try{localStorage.setItem('ei-theme',n)}catch(e){}
  if (typeof updateGlobeTheme === 'function') updateGlobeTheme();
}
try{const s=localStorage.getItem('ei-theme');if(s)document.documentElement.setAttribute('data-theme',s)}catch(e){}

/* ═══ Nav scroll ═══ */
const navEl=document.getElementById('main-nav');let ticking=false;
window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(()=>{navEl.classList.toggle('scrolled',window.scrollY>60);ticking=false});ticking=true}});

/* ═══ Funding: copy / contribute ═══ */
const FUNDING_ADDRESS='0x0000000000000000000000000000000000000000';
let qrRendered=false;

async function copyAddress(){
  const btn=document.querySelector('.btn-copy');if(!btn)return;
  try{await navigator.clipboard.writeText(FUNDING_ADDRESS);}catch(e){return}
  const o=btn.textContent;btn.textContent='Copied';btn.disabled=true;
  setTimeout(()=>{btn.textContent=o;btn.disabled=false},1600);
}

function renderQR(){
  if(qrRendered||typeof qrcode!=='function')return;
  const target=document.getElementById('qr-code');if(!target)return;
  // Type 0 = auto, error correction 'M'. Data is raw address; most wallets parse it.
  const qr=qrcode(0,'M');
  qr.addData(FUNDING_ADDRESS);
  qr.make();
  target.innerHTML=qr.createSvgTag({cellSize:6,margin:0,scalable:true});
  qrRendered=true;
}

function openContribute(){
  const modal=document.getElementById('contribute-modal');if(!modal)return;
  modal.hidden=false;
  modal.setAttribute('aria-hidden','false');
  document.body.style.overflow='hidden';
  renderQR();
  // Populate the address text on first open
  const addrEl=document.getElementById('modal-addr-text');
  if(addrEl)addrEl.textContent=FUNDING_ADDRESS;
  const linkEl=document.getElementById('modal-address-link');
  if(linkEl)linkEl.href='https://etherscan.io/address/'+FUNDING_ADDRESS;
}

function closeContribute(){
  const modal=document.getElementById('contribute-modal');if(!modal)return;
  modal.hidden=true;
  modal.setAttribute('aria-hidden','true');
  document.body.style.overflow='';
}

function contribute(){openContribute()}

async function copyFromModal(){
  const btn=document.querySelector('.btn-copy-address');if(!btn)return;
  try{await navigator.clipboard.writeText(FUNDING_ADDRESS);}catch(e){return}
  const o=btn.textContent;btn.textContent='Copied';btn.disabled=true;
  setTimeout(()=>{btn.textContent=o;btn.disabled=false},1800);
}

/* Esc key closes modal */
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    const m=document.getElementById('contribute-modal');
    if(m&&!m.hidden)closeContribute();
  }
});

/* ═══ Reveal on load (matches placeholder's fu/d* fade-up timing) ═══ */
window.addEventListener('load',()=>{document.body.classList.add('loaded')});
</script>

</body>
</html>
