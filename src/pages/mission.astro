<script is:inline>
/* ═══ Theme ═══ */
function toggleTheme(){
  const h=document.documentElement;
  const n=h.getAttribute('data-theme')==='dark'?'light':'dark';
  h.setAttribute('data-theme',n);
  try{localStorage.setItem('ei-theme',n)}catch(e){}
}
try{const s=localStorage.getItem('ei-theme');if(s)document.documentElement.setAttribute('data-theme',s)}catch(e){}

/* ═══ Nav scroll ═══ */
const navEl=document.getElementById('main-nav');let ticking=false;
window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(()=>{navEl.classList.toggle('scrolled',window.scrollY>60);ticking=false});ticking=true}});

/* ═══ Reveal on scroll ═══ */
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}})},{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

/* ═══ Scroll-scrubbed sweep reveal on the mission prose ═══
   Drives a single CSS custom property (--reveal-pct) on .intro-text
   from the scroll position. The CSS mask gradient does the rest -
   no per-word DOM mutations, so it reads as a smooth continuous
   sweep instead of a sequence of word transitions. */
(function(){
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  const introText=document.querySelector('.intro-text');
  if(!introText)return;

  let scrubTicking=false;
  function updateReveal(){
    scrubTicking=false;
    const rect=introText.getBoundingClientRect();
    const vh=window.innerHeight;
    // Reading line at 55% of viewport - everything above the line gets
    // lit, below stays dim. 55% (not 50%) so the bright zone leads the
    // eye rather than lagging behind it.
    const readLine=vh*0.55;
    const within=readLine-rect.top;
    const pct=Math.max(0,Math.min(100,(within/rect.height)*100));
    introText.style.setProperty('--reveal-pct',pct+'%');
  }
  function onScrubScroll(){
    if(!scrubTicking){requestAnimationFrame(updateReveal);scrubTicking=true;}
  }
  window.addEventListener('scroll',onScrubScroll,{passive:true});
  window.addEventListener('resize',onScrubScroll);
  updateReveal();
})();
</script>

