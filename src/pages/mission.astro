        <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.07" y2="4.93"/>
      </svg>
    </button>
    <a href="mailto:hello@ethinstitute.org?subject=Ethereum%20Institute%20Inquiry" class="btn-nav">Reach Out</a>
  </div>
</nav>

<main class="mission-page">
  <div class="inner mission-hero fu d1">
    <h1 class="page-title">Mission</h1>
    <p class="mission-lede">An independent non-profit dedicated to accelerating the institutional adoption of Ethereum, its L2s, applications and overall ecosystem.</p>
  </div>

  <div class="rule"></div>

  <section id="activities" class="archive-section" aria-labelledby="activities-title">
    <div class="inner reveal">
      <div class="s-label">What We Do</div>
      <h2 class="s-title" id="activities-title">Five Key Focus Areas</h2>
      <div class="archive-list">
        <div class="archive-item">
          <div class="archive-title-wrap" style="flex-direction:column;align-items:flex-start;gap:0">
            <h3>Institutional Education &amp; Engagement</h3>
            <p class="archive-desc">Structured programs for Tier-1 banks, asset managers, custodians, and sovereign institutions. Measured by high-quality institutional engagements and concrete wins for Ethereum, including production deployments, pilots, and committed roadmaps.</p>
          </div>
          <span class="archive-date">Engagement</span>
        </div>
        <div class="archive-item">
          <div class="archive-title-wrap" style="flex-direction:column;align-items:flex-start;gap:0">
            <h3>Institutional Intelligence</h3>
            <p class="archive-desc">Systematic mapping of institutional onchain activity and pipelines, with requirements and feedback gathered from institutions and routed to the teams building Ethereum and its ecosystem.</p>
          </div>
          <span class="archive-date">Research</span>
        </div>
        <div class="archive-item">
          <div class="archive-title-wrap" style="flex-direction:column;align-items:flex-start;gap:0">
            <h3>ETH &amp; Ecosystem Marketing</h3>
            <p class="archive-desc">Coordinated communications that position ETH as the leading institutional asset and promote institutional adoption across the broader Ethereum ecosystem, highlighting concrete deployments, partnerships, and new use cases.</p>
          </div>
          <span class="archive-date">Marketing</span>
        </div>
        <div class="archive-item">
          <div class="archive-title-wrap" style="flex-direction:column;align-items:flex-start;gap:0">
            <h3>Standards &amp; Best Practices</h3>
            <p class="archive-desc">Practical frameworks institutions can rely on when they design, integrate, operate, custody, issue, and settle on Ethereum. Open, neutral, and shaped by the institutions that use them.</p>
          </div>
          <span class="archive-date">Standards</span>
        </div>
        <div class="archive-item">
          <div class="archive-title-wrap" style="flex-direction:column;align-items:flex-start;gap:0">
            <h3>Institutional Events</h3>
            <p class="archive-desc">Flagship events and focused working groups that put institutions and the Ethereum ecosystem in the same room, on neutral ground. The Institutional Ethereum Forum convenes in New York and Hong Kong.</p>
          </div>
          <span class="archive-date">Events</span>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section id="coverage" aria-labelledby="coverage-title">
    <div class="inner reveal">
      <div class="s-label">Who We Serve</div>
      <h2 class="s-title" id="coverage-title">Across the Institutional Stack</h2>
      <p class="s-desc">Every layer of the institutional ecosystem evaluating Ethereum, from balance-sheet allocators to market infrastructure.</p>
      <div class="cov-grid">
        <span class="cov-pill">Banks</span><span class="cov-pill">Asset Managers</span><span class="cov-pill">Custodians</span><span class="cov-pill">Market Infrastructure</span>
        <span class="cov-pill">Fintechs</span><span class="cov-pill">Sovereign Institutions</span><span class="cov-pill">Regulators</span><span class="cov-pill">Exchanges</span>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="footer-left">&copy; 2026 Ethereum Institutional.</div>
  <div class="footer-center">
    <a href="https://x.com/ETHInstituteorg" target="_blank" rel="noopener" class="social-icon" aria-label="Ethereum Institutional on X">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
