    <svg class="nav-logo-mark" viewBox="0 0 140 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M69.9988 239.096L0 136.455L69.9988 181.206L140 136.455L69.9988 239.096Z" class="orb-f"/>
