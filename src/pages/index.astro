const ASSETS=['USDC','USDT','ETH','stETH','WBTC','USDe','PYUSD'];
const LAND_BOXES=[[60,72,-170,-140],[66,72,-140,-95],[52,70,-130,-80],[45,60,-125,-65],[30,49,-125,-65],[24,38,-120,-75],[18,32,-115,-90],[14,20,-92,-82],[8,15,-88,-77],[-10,12,-82,-55],[-25,-5,-75,-35],[-40,-20,-72,-40],[-55,-38,-75,-60],[36,44,-9,3],[40,52,-5,15],[48,60,-10,30],[55,71,5,32],[36,48,10,30],[40,60,20,60],[35,41,21,29],[15,37,-18,35],[5,18,-17,50],[-12,8,10,50],[-35,-10,12,42],[12,33,34,60],[40,75,30,180],[8,37,68,98],[10,28,92,110],[-10,10,95,125],[20,54,75,135],[33,43,124,132],[30,46,128,146],[-10,6,95,141],[5,19,116,127],[-44,-10,112,154],[-47,-34,165,179],[60,84,-55,-20],[63,67,-25,-13]];

function fetchWithTimeout(url,ms){return Promise.race([fetch(url),new Promise((_,rej)=>setTimeout(()=>rej(new Error('timeout')),ms))])}

async function loadWorldData(){
  if(typeof THREE==='undefined')return;
  try{
    if(typeof topojson==='undefined'||!topojson.feature)throw new Error('topojson missing');
    const res=await fetchWithTimeout('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json',10000);
    if(!res.ok)throw new Error('HTTP '+res.status);
    const topo=await res.json();
    const countries=topojson.feature(topo,topo.objects.countries);
    const borders=topojson.mesh(topo,topo.objects.countries,(a,b)=>a!==b);
    GLOBE.worldData={countries,borders};
    const W=2048,H=1024;const c=document.createElement('canvas');c.width=W;c.height=H;
    const ctx=c.getContext('2d');ctx.fillStyle='#fff';
    const drawPoly=(poly)=>{ctx.beginPath();poly.forEach(ring=>{ring.forEach((p,i)=>{const x=(p[0]+180)/360*W;const y=(90-p[1])/180*H;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});ctx.closePath()});ctx.fill('evenodd')};
    countries.features.forEach(f=>{const g=f.geometry;if(!g)return;if(g.type==='MultiPolygon')g.coordinates.forEach(drawPoly);else if(g.type==='Polygon')drawPoly(g.coordinates)});
    GLOBE.landMaskData=ctx.getImageData(0,0,W,H).data;GLOBE.landMaskW=W;GLOBE.landMaskH=H;
  }catch(e){console.warn('[globe] TopoJSON load failed, using fallback:',e.message);GLOBE.worldData=null}
  buildGlobe();
}

function isLand(lat,lng){
  if(GLOBE.landMaskData){
    const x=Math.floor((lng+180)/360*GLOBE.landMaskW);
    const y=Math.floor((90-lat)/180*GLOBE.landMaskH);
    if(x<0||x>=GLOBE.landMaskW||y<0||y>=GLOBE.landMaskH)return false;
    return GLOBE.landMaskData[(y*GLOBE.landMaskW+x)*4+3]>128;
  }
  for(let i=0;i<LAND_BOXES.length;i++){const [lat1,lat2,lng1,lng2]=LAND_BOXES[i];if(lat>=lat1&&lat<=lat2&&lng>=lng1&&lng<=lng2)return true}
  return false;
}

function latLngToVec3(lat,lng,r){const phi=(90-lat)*Math.PI/180;const theta=(lng+180)*Math.PI/180;return new THREE.Vector3(-r*Math.sin(phi)*Math.cos(theta),r*Math.cos(phi),r*Math.sin(phi)*Math.sin(theta))}
function getThemeColor(){return document.documentElement.getAttribute('data-theme')==='dark'?0xede8df:0x1a1918}

function buildGlobe(){
  const rect=canvas.getBoundingClientRect();
  const w=rect.width||500,h=rect.height||500;
  const color=getThemeColor();const isDark=document.documentElement.getAttribute('data-theme')==='dark';
  GLOBE.scene=new THREE.Scene();
  GLOBE.camera=new THREE.PerspectiveCamera(45,1,0.1,1000);GLOBE.camera.position.z=3.2;
  GLOBE.renderer=new THREE.WebGLRenderer({canvas,alpha:true,antialias:true});
  GLOBE.renderer.setSize(w,h);GLOBE.renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  GLOBE.renderer.setClearColor(0x000000,0);
  GLOBE.raycaster=new THREE.Raycaster();GLOBE.mouse=new THREE.Vector2();GLOBE.group=new THREE.Group();
  const positions=[];const R=1.002;const step=1.3;
  for(let lat=-85;lat<=85;lat+=step){
    const lngStep=step/Math.max(0.3,Math.cos(lat*Math.PI/180));
    for(let lng=-180;lng<=180;lng+=lngStep){
      if(!isLand(lat,lng))continue;
      const v=latLngToVec3(lat,lng,R);positions.push(v.x,v.y,v.z);
    }
  }
  const dotGeo=new THREE.BufferGeometry();
  dotGeo.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));
  GLOBE.dotMat=new THREE.PointsMaterial({color,size:isDark?0.014:0.012,transparent:true,opacity:isDark?0.9:0.8,sizeAttenuation:true});
  GLOBE.group.add(new THREE.Points(dotGeo,GLOBE.dotMat));
  GLOBE.group.rotation.x=0.3;GLOBE.group.rotation.y=-0.6;GLOBE.scene.add(GLOBE.group);
  HUBS.forEach(hub=>{
    const v=latLngToVec3(hub.lat,hub.lng,1.01);
    const hubGeo=new THREE.BufferGeometry();
    hubGeo.setAttribute('position',new THREE.Float32BufferAttribute([v.x,v.y,v.z],3));
    const hubMat=new THREE.PointsMaterial({color,size:0.018,transparent:true,opacity:0.8,sizeAttenuation:true});
    GLOBE.hubMats.push(hubMat);GLOBE.group.add(new THREE.Points(hubGeo,hubMat));
  });
  animateLoop();
}

function createArc(){
  if(!GLOBE.group)return;
  const color=getThemeColor();
  const a=HUBS[Math.floor(Math.random()*HUBS.length)];
  let b=HUBS[Math.floor(Math.random()*HUBS.length)];
  while(b===a)b=HUBS[Math.floor(Math.random()*HUBS.length)];
  const start=latLngToVec3(a.lat,a.lng,1);const end=latLngToVec3(b.lat,b.lng,1);
  const dist=start.distanceTo(end);
  const mid=new THREE.Vector3().addVectors(start,end).multiplyScalar(0.5);
  mid.normalize().multiplyScalar(1.15+dist*0.4);
  const curve=new THREE.QuadraticBezierCurve3(start,mid,end);
  const tubeGeo=new THREE.TubeGeometry(curve,40,0.0028,6,false);
  const tubeMat=new THREE.MeshBasicMaterial({color,transparent:true,opacity:0});
  const tube=new THREE.Mesh(tubeGeo,tubeMat);
  const asset=ASSETS[Math.floor(Math.random()*ASSETS.length)];
  const amount=Math.floor(Math.random()*500000)+1000;
  const hash='0x'+Math.random().toString(16).slice(2,6)+'...'+Math.random().toString(16).slice(2,6);
  tube.userData={asset,amount,hash,hubA:a.name,hubB:b.name};
  const particleGeo=new THREE.BufferGeometry();
  particleGeo.setAttribute('position',new THREE.Float32BufferAttribute([start.x,start.y,start.z],3));
  const particleMat=new THREE.PointsMaterial({color,size:0.026,transparent:true,opacity:0,sizeAttenuation:true,blending:THREE.AdditiveBlending});
  const particle=new THREE.Points(particleGeo,particleMat);
  GLOBE.group.add(tube);GLOBE.group.add(particle);GLOBE.arcMeshes.push(tube);
  GLOBE.arcs.push({tube,particle,curve,progress:0,life:0,maxLife:60,speed:0.020+Math.random()*0.014,baseOpacity:0.24,particleOpacity:0.85});
}
function updateArcs(){
  for(let i=GLOBE.arcs.length-1;i>=0;i--){
    const a=GLOBE.arcs[i];a.progress+=a.speed;a.life++;
    if(a.progress<1){const pos=a.curve.getPoint(a.progress);const arr=a.particle.geometry.attributes.position.array;arr[0]=pos.x;arr[1]=pos.y;arr[2]=pos.z;a.particle.geometry.attributes.position.needsUpdate=true}
    if(a.life<10){const k=a.life/10;a.tube.material.opacity=a.baseOpacity*k;a.particle.material.opacity=a.particleOpacity*k}
    const fadeStart=a.maxLife-18;
    if(a.life>fadeStart){const k=(a.life-fadeStart)/18;a.tube.material.opacity=a.baseOpacity*(1-k);a.particle.material.opacity=a.particleOpacity*(1-k)}
    if(a.life>=a.maxLife){GLOBE.group.remove(a.tube);GLOBE.group.remove(a.particle);a.tube.geometry.dispose();a.tube.material.dispose();a.particle.geometry.dispose();a.particle.material.dispose();const idx=GLOBE.arcMeshes.indexOf(a.tube);if(idx>-1)GLOBE.arcMeshes.splice(idx,1);GLOBE.arcs.splice(i,1)}
  }
}
let arcInterval=null;
function startArcSpawner(){arcInterval=setInterval(()=>{if(GLOBE.arcs.length<40)createArc()},30);for(let i=0;i<25;i++)setTimeout(createArc,i*20)}
function animateLoop(){GLOBE.animId=requestAnimationFrame(animateLoop);if(!GLOBE.group||!GLOBE.renderer)return;if(!isDraggingGlobe)GLOBE.group.rotation.y+=0.0008;updateArcs();GLOBE.renderer.render(GLOBE.scene,GLOBE.camera)}
function updateGlobeTheme(){if(!GLOBE.dotMat)return;const isDark=document.documentElement.getAttribute('data-theme')==='dark';const color=getThemeColor();GLOBE.dotMat.color.setHex(color);GLOBE.dotMat.opacity=isDark?0.9:0.8;GLOBE.dotMat.size=isDark?0.014:0.012;if(GLOBE.borderMat)GLOBE.borderMat.color.setHex(color);GLOBE.hubMats.forEach(m=>m.color.setHex(color));GLOBE.arcs.forEach(a=>{a.tube.material.color.setHex(color);a.particle.material.color.setHex(color)})}
function onGlobeResize(){if(!GLOBE.renderer||!canvas)return;const rect=canvas.getBoundingClientRect();GLOBE.renderer.setSize(rect.width,rect.height);GLOBE.camera.aspect=1;GLOBE.camera.updateProjectionMatrix()}
window.addEventListener('resize',onGlobeResize);

let isDraggingGlobe=false,prevX=0,prevY=0;
canvas.addEventListener('pointerdown',e=>{isDraggingGlobe=true;prevX=e.clientX;prevY=e.clientY;canvas.setPointerCapture(e.pointerId)});
canvas.addEventListener('pointermove',e=>{
  if(isDraggingGlobe&&GLOBE.group){GLOBE.group.rotation.y+=(e.clientX-prevX)*0.005;GLOBE.group.rotation.x=Math.max(-0.8,Math.min(0.8,GLOBE.group.rotation.x+(e.clientY-prevY)*0.005));prevX=e.clientX;prevY=e.clientY;hideGlobeTooltip();return}
  if(!GLOBE.raycaster||!GLOBE.arcMeshes.length)return;
  const rect=canvas.getBoundingClientRect();
  GLOBE.mouse.x=((e.clientX-rect.left)/rect.width)*2-1;
  GLOBE.mouse.y=-((e.clientY-rect.top)/rect.height)*2+1;
  GLOBE.raycaster.setFromCamera(GLOBE.mouse,GLOBE.camera);
  const hits=GLOBE.raycaster.intersectObjects(GLOBE.arcMeshes);
  if(hits.length>0)showGlobeTooltip(e.clientX-rect.left,e.clientY-rect.top,hits[0].object.userData);
  else hideGlobeTooltip();
});
canvas.addEventListener('pointerup',()=>isDraggingGlobe=false);
canvas.addEventListener('pointercancel',()=>isDraggingGlobe=false);
canvas.addEventListener('pointerleave',()=>{isDraggingGlobe=false;hideGlobeTooltip()});

function showGlobeTooltip(x,y,tx){document.getElementById('tx-asset').textContent=tx.asset;document.getElementById('tx-amount').textContent='$'+tx.amount.toLocaleString();document.getElementById('tx-hash').textContent=tx.hash+' · '+tx.hubA+' → '+tx.hubB;tooltip.style.left=x+'px';tooltip.style.top=y+'px';tooltip.classList.add('show')}
function hideGlobeTooltip(){tooltip.classList.remove('show')}

if(document.fonts&&document.fonts.ready)document.fonts.ready.then(loadWorldData);
else window.addEventListener('load',loadWorldData);
</script>

