---
import Base from '../layouts/Base.astro';

const focusAreas = [
  {
    id: 'research',
    title: 'Research',
    body: 'Open, peer-reviewed work on protocol design, scaling, cryptoeconomics, and the security of decentralized systems.',
  },
  {
    id: 'education',
    title: 'Education',
    body: 'Curricula, workshops, and explainers that take builders from first principles to production-grade smart contracts.',
  },
  {
    id: 'community',
    title: 'Community',
    body: 'A neutral home for researchers, developers, and institutions to collaborate in the open and in the public interest.',
  },
];
---

<Base>
  <section class="container hero">
    <p class="eyebrow">Independent · Open · Public good</p>
    <h1>Advancing Ethereum through<br /><span class="grad">research and education.</span></h1>
    <p class="lede">
      The Ethereum Institute is a non-profit hub for rigorous research, practical
      education, and open collaboration across the Ethereum ecosystem.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/#research">Explore our work</a>
      <a class="btn ghost" href="/#about">About the Institute</a>
    </div>
  </section>

  <section class="container grid" aria-label="Focus areas">
    {focusAreas.map((area) => (
      <article class="card" id={area.id}>
        <h2>{area.title}</h2>
        <p>{area.body}</p>
      </article>
    ))}
  </section>

  <section class="container about" id="about">
    <h2>Built in the open, for everyone.</h2>
    <p>
      We believe the infrastructure of the open internet should be studied,
      taught, and improved in public. The Institute publishes its research freely,
      keeps its educational material open-source, and works with the broader
      community to strengthen the foundations of decentralized systems.
    </p>
    <p class="note">This site is in early development — more soon.</p>
  </section>

  <style>
    .hero { padding-top: 64px; padding-bottom: 48px; }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.78rem;
      color: var(--accent-2);
      margin: 0 0 14px;
    }
    h1 {
      font-size: clamp(2.1rem, 5.5vw, 3.6rem);
      line-height: 1.08;
      margin: 0 0 18px;
      letter-spacing: -0.02em;
    }
    .grad {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .lede { font-size: 1.15rem; color: var(--muted); max-width: 60ch; margin: 0 0 28px; }

    .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
    .btn {
      display: inline-block;
      padding: 12px 22px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      border: 1px solid transparent;
      transition: transform 0.12s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn.primary { background: linear-gradient(90deg, var(--accent), #6c7cff); color: #0b0e17; }
    .btn.ghost { border-color: var(--border); color: var(--text); }
    .btn.ghost:hover { border-color: var(--accent); }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 24px;
    }
    .card {
      background: linear-gradient(180deg, var(--panel), var(--bg-soft));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px 24px;
      scroll-margin-top: 90px;
    }
    .card h2 { margin: 0 0 10px; font-size: 1.25rem; }
    .card p { margin: 0; color: var(--muted); }

    .about { margin-top: 72px; scroll-margin-top: 90px; max-width: 70ch; }
    .about h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin: 0 0 16px; letter-spacing: -0.01em; }
    .about p { color: var(--muted); font-size: 1.05rem; }
    .note { color: var(--accent-2); font-size: 0.95rem; }

    @media (max-width: 820px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
