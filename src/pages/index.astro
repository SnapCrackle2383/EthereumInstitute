<script is:inline>
/* ═══ Theme ═══ */
function toggleTheme(){
  const h=document.documentElement;
  const n=h.getAttribute('data-theme')==='dark'?'light':'dark';
  h.setAttribute('data-theme',n);
  try{localStorage.setItem('ei-theme',n)}catch(e){}
  if (typeof updateGlobeTheme === 'function') updateGlobeTheme();
}
try{const s=localStorage.getItem('ei-theme');if(s)document.documentElement.setAttribute('data-theme',s)}catch(e){}

/* ═══ Nav scroll ═══ */
const navEl=document.getElementById('main-nav');let ticking=false;
window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(()=>{navEl.classList.toggle('scrolled',window.scrollY>60);ticking=false});ticking=true}});

/* ═══ GLOBE ═══ */
const GLOBE={scene:null,camera:null,renderer:null,group:null,arcs:[],arcMeshes:[],raycaster:null,mouse:null,dotMat:null,borderMat:null,hubMats:[],animId:null,worldData:null,landMaskData:null,landMaskW:0,landMaskH:0};
const canvas=document.getElementById('globe-canvas');
const tooltip=document.getElementById('tx-tooltip');

const HUBS=[
